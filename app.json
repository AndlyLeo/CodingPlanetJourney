{
  "expo": {
    "name": "CodingPlanetJourney",
    "slug": "CodingPlanetJourney",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/images/logo/icon.png",
    "scheme": "codingplanetjourney",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo/android-icon-foreground.png",
        "backgroundImage": "./assets/images/logo/android-icon-background.png",
        "monochromeImage": "./assets/images/logo/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.http36cc.CodingPlanetJourney"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/logo/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d5269110-2053-4b53-bd38-e07bd6715f5b"
      }
    }
  }
}
